# Copy this file to .env.local and fill in the values from your Supabase project.
# Never commit .env.local — it contains secrets.
#
# Find these values in: Supabase Dashboard → Project Settings → API

# The public URL of your Supabase project (e.g. https://xyzxyz.supabase.co)
VITE_SUPABASE_URL=

# The public anonymous key of your Supabase project (safe to expose in the browser)
VITE_SUPABASE_ANON_KEY=
